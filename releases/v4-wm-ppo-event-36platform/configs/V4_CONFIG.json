{
  "schema": "n02-v4-wm-ppo-config/1",
  "version": "v4-dynamic-wm-ppo-100x100",
  "seeds": {
    "world_model": [8201, 8202, 8203],
    "policy": [8201, 8202, 8203],
    "branch": 842701,
    "registry": {"source": "v3_shards.expected_registry", "test_base": 840000}
  },
  "scenario": {
