    "review_gate": "environment_review.json",
    "max_branch_minutes": 8,
    "branch_schedule": "fixed-seed-uniform-distinct-minutes",
    "branch_horizon_minutes": 10,
    "max_branch_action_minutes": 8,
    "random_branch_actions": 2,
    "cpu_threads": 1,
    "branch_action_names": ["NOOP", "public_best", "random_1", "random_2"],
    "train_validation_samples_only": true,
    "test_registry_frozen_before_collection": true
